    {
      "name": "Acción primaria",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción de píldora; respuesta de opacidad y pulsación.",
      "html": "<button class=\"ds-button-primary\">Ver ficha</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:38px;padding:0 17px;border:0;border-radius:99px;background:var(--text,#fff);color:var(--ground,#000);font-family:var(--font-inter,Inter),sans-serif;font-size:13px;font-weight:500;white-space:nowrap;cursor:pointer;transition:transform 160ms cubic-bezier(0.23,1,0.32,1),opacity 160ms cubic-bezier(0.23,1,0.32,1);}.ds-button-primary:hover:not(:disabled){opacity:.85;}.ds-button-primary:active:not(:disabled){transform:scale(.97);}.ds-button-primary:disabled{color:var(--faint,#949494);cursor:not-allowed;}.ds-button-primary:focus-visible{outline:2px solid var(--accent,#ff7b83);outline-offset:5px;}@media(max-width:650px){.ds-button-primary{min-height:44px;}}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"
    },
    {
      "name": "Acción secundaria",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Acción de píldora; respuesta de opacidad y pulsación.",
      "html": "<button class=\"ds-button-secondary\">Guardar en mi lista</button>",
      "css": ".ds-button-secondary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:38px;padding:0 17px;border:0;border-radius:99px;background:var(--raised,#2a2a2a);color:var(--text,#fff);font-family:var(--font-inter,Inter),sans-serif;font-size:13px;font-weight:500;white-space:nowrap;cursor:pointer;transition:transform 160ms cubic-bezier(0.23,1,0.32,1),opacity 160ms cubic-bezier(0.23,1,0.32,1);}.ds-button-secondary:hover:not(:disabled){opacity:.85;}.ds-button-secondary:active:not(:disabled){transform:scale(.97);}.ds-button-secondary:disabled{color:var(--faint,#949494);cursor:not-allowed;}.ds-button-secondary:focus-visible{outline:2px solid var(--accent,#ff7b83);outline-offset:5px;}@media(max-width:650px){.ds-button-secondary{min-height:44px;}}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none;}}"
    },
    {
      "name": "Filtro nativo",
      "kind": "input",
      "refersTo": "input-filter",
      "description": "Etiqueta persistente y selector nativo del catálogo.",
      "html": "<label class=\"ds-filter\">Género<select class=\"ds-select\"><option>Todos los géneros</option><option>Drama</option></select></label>",
      "css": ".ds-filter{display:flex;flex-direction:column;gap:6px;min-width:120px;font-family:var(--font-inter,Inter),sans-serif;font-size:11px;color:var(--muted,#b4b4b4);}.ds-select{min-height:38px;width:100%;padding:0 12px;border:1px solid var(--control,#444);border-radius:8px;color:var(--text,#fff);background:var(--surface,#111);font-family:inherit;font-size:14px;color-scheme:dark;}.ds-select:focus-visible{outline:2px solid var(--accent,#ff7b83);outline-offset:5px;}@media(max-width:650px){.ds-filter{font-size:12px;}.ds-select{min-height:42px;font-size:12px;}}"
    },
    {
      "name": "Navegación principal",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Destinos discretos, acceso a Elige por mí y biblioteca con nombre accesible estable.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Navegación principal\"><a href=\"#\" aria-current=\"page\">Descubre</a><a href=\"#\">Películas</a><a href=\"#\">Series</a><a href=\"/decide\">Elige por mí</a><a class=\"ds-library\" href=\"/watchlist\" aria-label=\"Mi lista\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M6 3h12v18l-6-4-6 4V3Z\"/></svg><span>Mi lista</span></a></nav>",
      "css": ".ds-nav{display:flex;align-items:center;gap:28px;padding:20px;background:var(--ground,#000);font-family:var(--font-inter,Inter),sans-serif;}.ds-nav a{color:var(--muted,#b4b4b4);font-size:13px;font-weight:500;text-decoration:none;white-space:nowrap;}.ds-nav a:hover,.ds-nav a[aria-current]{color:var(--text,#fff);}.ds-nav a:focus-visible{outline:2px solid var(--accent,#ff7b83);outline-offset:5px;}@media(max-width:1150px){.ds-nav{gap:20px;}}@media(max-width:900px){.ds-nav{gap:16px;}}.ds-library{display:flex;align-items:center;gap:8px;}@media(max-width:900px){.ds-library span{display:none;}}@media(max-width:650px){.ds-library span{display:inline;font-size:12px;}}"
    },
    {
      "name": "Géneros",
      "kind": "chip",
      "refersTo": "chip-genre",
      "description": "Píldoras de género con selección blanca y hover neutral.",
      "html": "<div class=\"ds-genres\"><a class=\"ds-genre ds-selected\" href=\"#\">Para ti</a><a class=\"ds-genre\" href=\"#\">Drama</a><a class=\"ds-genre\" href=\"#\">Comedia</a></div>",
      "css": ".ds-genres{display:flex;gap:8px;overflow-x:auto;padding:6px;}.ds-genre{padding:8px 17px;border-radius:99px;white-space:nowrap;color:var(--muted,#b4b4b4);background:var(--surface,#111);font-family:var(--font-inter,Inter),sans-serif;font-size:13px;text-decoration:none;}.ds-genre:hover{background:var(--raised,#2a2a2a);color:var(--text,#fff);}.ds-genre.ds-selected{background:var(--text,#fff);color:var(--ground,#000);}.ds-genre:focus-visible{outline:2px solid var(--accent,#ff7b83);outline-offset:5px;}@media(max-width:650px){.ds-genre{font-size:12px;padding:8px 15px;}.ds-genres{gap:7px;}}"
    },
    {
      "name": "Cartel sin imagen",
      "kind": "card",
      "refersTo": "movie-poster",
      "description": "Estado real de imagen ausente; conserva la proporción del cartel sin inventar una fotografía.",
      "html": "<article class=\"ds-movie\"><a class=\"ds-poster\" href=\"#\" aria-label=\"Ver ficha\"><span class=\"ds-fallback\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M7 3v18M17 3v18M3 8h4m10 0h4M3 16h4m10 0h4\"/></svg><span>Cartel no disponible</span></span></a><div class=\"ds-card-meta\">Sin fecha · Película</div><h3 class=\"ds-card-title\"><a href=\"#\">Título del catálogo</a></h3></article>",
      "css": ".ds-movie{width:180px;min-width:0;color:var(--text,#fff);font-family:var(--font-inter,Inter),sans-serif;}.ds-poster{display:block;aspect-ratio:2/3;position:relative;background:var(--surface,#111);overflow:hidden;border-radius:8px;text-decoration:none;}.ds-fallback{height:100%;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:12px;color:var(--muted,#b4b4b4);background:var(--raised,#2a2a2a);padding:20px;text-align:center;font-size:12px;}.ds-card-meta{margin:12px 0 5px;color:var(--faint,#949494);font-size:12px;}.ds-card-title{margin:0;font-size:14px;font-weight:500;line-height:1.5;}.ds-card-title a{color:inherit;text-decoration:none;}.ds-poster:focus-visible{outline:2px solid var(--accent,#ff7b83);outline-offset:5px;}.ds-card-title a:focus-visible{outline:2px solid var(--accent,#ff7b83);outline-offset:5px;}@media(max-width:650px){.ds-card-title{font-size:13px;}.ds-card-meta{margin-top:9px;}}"
    },
    {
      "name": "Panel neutral",
      "kind": "card",
      "refersTo": "panel",
      "description": "Contenedor plano de recomendaciones, información y estados vacíos.",
      "html": "<section class=\"ds-panel\"><h2>En tu radar</h2><p>Muy bien valoradas</p></section>",
      "css": ".ds-panel{background:var(--surface,#111);color:var(--text,#fff);border-radius:var(--radius,16px);padding:22px;font-family:var(--font-inter,Inter),sans-serif;}.ds-panel h2{margin:0 0 3px;font-size:16px;font-weight:600;line-height:1.3;letter-spacing:-.025em;}.ds-panel p{margin:0;color:var(--muted,#b4b4b4);font-size:13px;line-height:1.5;}@media(max-width:1150px){.ds-panel{padding:18px;}}"
    },
    {
      "name": "Acceso compacto a Elige por mí",
      "kind": "custom",
      "refersTo": "panel",
      "description": "Hasta 900 px, el enlace a la mesa de selección permanece debajo del destacado del inicio.",
      "html": "<section class=\"ds-surprise-panel\"><div class=\"ds-surprise\"><h3><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M3 5h4l10 14h4m-4-4 4 4-4 3M3 19h4L17 5h4m-4-3 4 3-4 4\"/></svg>¿No te decides?</h3><p>Prepara tu selección y deja que la ruleta elija la película.</p><div class=\"ds-surprise-actions\"><a href=\"/decide\">Elige por mí<svg width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></svg></a></div></div></section>",
      "css": ".ds-surprise-panel{display:none;}@media(max-width:900px){.ds-surprise-panel{display:block;background:var(--surface,#111);color:var(--text,#fff);border-radius:var(--radius,16px);padding:16px 20px;margin-top:14px;font-family:var(--font-inter,Inter),sans-serif;}.ds-surprise{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 16px;}.ds-surprise h3{display:flex;align-items:center;gap:8px;grid-column:1;grid-row:1;margin:0;font-size:13px;font-weight:500;line-height:1.45;}.ds-surprise p{grid-column:1/-1;grid-row:2;margin:0;font-size:12px;line-height:1.5;color:var(--muted,#b4b4b4);}.ds-surprise-actions{display:flex;align-items:center;grid-column:2;grid-row:1;gap:12px;}.ds-surprise a{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:32px;padding:0;border:0;background:transparent;color:var(--text,#fff);font-family:inherit;font-size:13px;font-weight:500;cursor:pointer;text-decoration:none;transition:transform 160ms cubic-bezier(.23,1,.32,1),opacity 160ms cubic-bezier(.23,1,.32,1);}.ds-surprise a:hover{opacity:.85;}.ds-surprise a:active{transform:scale(.97);}.ds-surprise a:focus-visible{outline:2px solid var(--accent,#ff7b83);outline-offset:5px;}.ds-surprise-status:empty{display:none;}}@media(max-width:650px){.ds-surprise a{min-height:44px;}}@media(prefers-reduced-motion:reduce){.ds-surprise a{transition:none;}}"
    },
    {
      "name": "Acción de decisión",
      "kind": "button",
      "refersTo": "button-decision",
      "description": "Generar selección y girar usan rojo de marca; deshabilitado vuelve a neutral.",
      "html": "<button class=\"ds-button-decision\">Generar selección</button>",
      "css": ".ds-button-decision{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:42px;padding:0 17px;border:0;border-radius:99px;background:var(--brand,#dc283a);color:var(--text,#fff);font-family:var(--font-inter,Inter),sans-serif;font-size:13px;font-weight:500;white-space:nowrap;cursor:pointer;transition:transform 160ms cubic-bezier(0.23,1,0.32,1),opacity 160ms cubic-bezier(0.23,1,0.32,1);}.ds-button-decision:hover:not(:disabled){opacity:.85;}.ds-button-decision:active:not(:disabled){transform:scale(.97);}.ds-button-decision:disabled{background:var(--raised,#2a2a2a);color:var(--muted,#b4b4b4);cursor:not-allowed;}.ds-button-decision:focus-visible{outline:2px solid var(--accent,#ff7b83);outline-offset:5px;}@media(max-width:650px){.ds-button-decision{min-height:44px;}}@media(prefers-reduced-motion:reduce){.ds-button-decision{transition:none;}}"
    },
    {
      "name": "Ruleta vacía",
      "kind": "custom",
      "refersTo": "panel",
      "description": "Panel de decisión con rueda SVG, estados explícitos y acción deshabilitada hasta tener dos candidatas.",
      "html": "<aside class=\"ds-wheel\"><h2>Tu ruleta</h2><p class=\"ds-wheel-count\">0 de 12 películas</p><div class=\"ds-wheel-stage\"><svg viewBox=\"0 0 320 320\" role=\"img\" aria-label=\"Ruleta sin películas\"><circle cx=\"160\" cy=\"160\" r=\"147\" fill=\"var(--surface,#111)\" stroke=\"var(--control,#444)\"/><circle cx=\"160\" cy=\"160\" r=\"28\" fill=\"var(--brand,#dc283a)\"/><text x=\"160\" y=\"161\" fill=\"white\" text-anchor=\"middle\" dominant-baseline=\"middle\" font-size=\"14\" font-weight=\"600\">FyM.</text><path d=\"M150 3h20l-10 19Z\" fill=\"var(--brand,#dc283a)\"/></svg><div class=\"ds-wheel-empty\"><span>Tu próxima película</span><p>Añade al menos 2 opciones para girar.</p></div></div><button class=\"ds-wheel-spin\" disabled>Girar la ruleta</button><p class=\"ds-wheel-note\">Tu ruleta se guarda en este navegador.</p></aside>",
      "css": ".ds-wheel{max-width:318px;padding:22px;border-radius:var(--radius,16px);background:var(--surface,#111);color:var(--text,#fff);font-family:var(--font-inter,Inter),sans-serif;}.ds-wheel h2{margin:0;font-size:18px;letter-spacing:-.02em;}.ds-wheel-count{font-size:13px;color:var(--muted,#b4b4b4);margin:5px 0 20px;}.ds-wheel-stage{position:relative;aspect-ratio:1;margin:0 -7px 15px;}.ds-wheel-stage svg{display:block;width:100%;height:100%;}.ds-wheel-empty{position:absolute;top:66%;left:16%;right:16%;text-align:center;}.ds-wheel-empty span{font-size:13px;}.ds-wheel-empty p{font-size:12px;color:var(--faint,#949494);margin:4px 0 0;}.ds-wheel-spin{width:100%;min-height:42px;padding:0 17px;border:0;border-radius:99px;background:var(--brand,#dc283a);color:var(--text,#fff);font-family:inherit;font-size:13px;font-weight:500;transition:transform 160ms var(--ease,cubic-bezier(.23,1,.32,1)),opacity 160ms var(--ease,cubic-bezier(.23,1,.32,1));}.ds-wheel-spin:hover:not(:disabled){opacity:.85;}.ds-wheel-spin:active:not(:disabled){transform:scale(.97);}.ds-wheel-spin:focus-visible{outline:2px solid var(--accent,#ff7b83);outline-offset:5px;}.ds-wheel-spin:disabled{background:var(--raised,#2a2a2a);color:var(--muted,#b4b4b4);cursor:not-allowed;}.ds-wheel-note{font-size:11px;color:var(--faint,#949494);text-align:center;margin:18px 0 0;}@media(max-width:650px){.ds-wheel{max-width:460px;}.ds-wheel-stage{max-width:320px;margin:0 auto 18px;}.ds-wheel-spin{min-height:46px;}.ds-wheel-note{font-size:12px;}}@media(prefers-reduced-motion:reduce){.ds-wheel-spin{transition:none;}}"
    }
